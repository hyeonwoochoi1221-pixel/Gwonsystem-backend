# Documentation only: substitute values in Render; never commit actual credentials.
SPRING_PROFILES_ACTIVE=dev
APP_DEPLOYMENT_ENV=dev
DEV_SUPABASE_PROJECT_REF=<approved-20-letter-development-project-ref>
DEV_DB_NAME=postgres
DEV_DB_ROLE=gwon_dev_app
# Direct connection:
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<development-project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&connectTimeout=10&socketTimeout=30
SPRING_DATASOURCE_USERNAME=gwon_dev_app
SPRING_DATASOURCE_PASSWORD=<development-role-password>
# Session pooler alternative: replace host in URL AND use username gwon_dev_app.<ref>.
# DEV_DB_POOLER_HOST=<exact-session-pooler-host>.pooler.supabase.com
# Transaction pooler port 6543 is intentionally not supported.
SUPABASE_URL=https://<development-project-ref>.supabase.co
SUPABASE_SECRET_KEY=<development-server-secret-key>
SUPABASE_STORAGE_BUCKET=<development-bucket>
FRONTEND_URL=https://<development-frontend-host>
CORS_ALLOWED_ORIGINS=https://<development-frontend-host>
DEV_ALLOWED_FRONTEND_ORIGINS=https://<approved-development-frontend-host>
# Empty means no logo image. Never falls back to the production image in dev.
EMAIL_LOGO_URL=
DEV_MAIL_ENABLED=false
DEV_OAUTH_ENABLED=false
DEV_PLACES_ENABLED=false
# Render supplies PORT. HTTPS cookies and schema validate are enforced by the guard.
# Do not add generic MAIL_*, GOOGLE_CLIENT_*, NAVER_CLIENT_* or GOOGLE_PLACES_API_KEY.

# Optional SMTP enablement requires ALL of these development-only values:
# DEV_MAIL_ENABLED=true
# DEV_MAIL_HOST=<development-smtp-host>
# DEV_MAIL_PORT=587
# DEV_MAIL_USERNAME=<development-mail-account>
# DEV_MAIL_PASSWORD=<development-smtp-password>
# DEV_MAIL_ALLOWED_RECIPIENTS=<approved-test-email>,<another-approved-test-email>

# Optional OAuth enablement requires BOTH dedicated provider applications:
# DEV_OAUTH_ENABLED=true
# DEV_BACKEND_ORIGIN=https://gwonsystem-backend-dev.onrender.com
# DEV_GOOGLE_CLIENT_ID=<development-google-id>
# DEV_GOOGLE_CLIENT_SECRET=<development-google-secret>
# DEV_NAVER_CLIENT_ID=<development-naver-id>
# DEV_NAVER_CLIENT_SECRET=<development-naver-secret>
# Register callbacks <DEV_BACKEND_ORIGIN>/login/oauth2/code/google and /naver.

# Optional paid Places access:
# DEV_PLACES_ENABLED=true
# DEV_GOOGLE_PLACES_API_KEY=<restricted-development-places-key>
